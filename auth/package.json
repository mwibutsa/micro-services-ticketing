{
  "name": "auth",
  "packageManager": "yarn@4.18.0",
  "type": "module",
  "scripts": {
    "start": "CHOKIDAR_USEPOLLING=true tsx watch  src/index.ts",
    "test": "jest --watchAll --no-cache",
    "build": "tsc"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/build/"
    ],
    "setupFilesAfterEnv": [
      "./src/test/setup.ts"
    ]
  },
  "dependencies": {
    "@mwibutsa/common": "^1.0.13",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^5.0.6",
    "cookie-session": "^2.1.1",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11"
  }
}
