{
  "name": "@mwibutsa/common",
  "version": "1.0.18",
  "description": "Shared package for the ticketing microservices project",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "build": "yarn clean && tsc",
    "clean": "del-cli ./build/*",
    "pub": "git add . && git commit -m 'update' && npm version patch && yarn build && npm publish --access public"
  },
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "build/**/*"
  ],
  "devDependencies": {
    "del-cli": "^6.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "cookie-session": "^2.1.0",
    "express": "^4.21.0",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "node-nats-streaming": "^0.3.2"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0"
  }
}
